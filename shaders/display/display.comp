#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, set = 0, rgba8) uniform writeonly image2D outputImage; // LDR world target image
layout(binding = 1, set = 0, rgba16f) uniform readonly image2D rtImage; // HDR RT radiance
layout(binding = 2, set = 0, r32f) uniform readonly image2D exposureImage; // 1x1 linear exposure scale
layout(binding = 3, set = 0, rgba16f) uniform writeonly image2D hdrImage; // PQ-encoded ([0,1], ST.2084) HDR display
layout(binding = 4, set = 0, rgba8) uniform readonly image2D rasterBackground; // vanilla + DH snapshot
layout(binding = 5, set = 0, r32f) uniform readonly image2D rtDepth; // render-res primary-hit mask
layout(binding = 6, set = 0) uniform sampler2D rasterDepth; // vanilla/DH reversed-Z depth
layout(binding = 0, set = 1) uniform accelerationStructureEXT worldTlas;

// HDR display parameters. hdrEnabled gates the parallel PQ write; the SDR AgX path always runs because
// vanilla main-target presentation still consumes LDR.
layout(push_constant) uniform Push {
    int hdrEnabled;        // 0 = SDR only, 1 = also write the PQ HDR image
    float paperWhiteNits;  // absolute nits SDR paper white maps to
    float headroom;        // highlight headroom above paper white (peakNits / paperWhiteNits, >= 1)
    int dhHybridEnabled;    // 0 off, 1 raster color only, 2 raster color + valid DH depth/matrix
    mat4 invViewProj;       // inverse camera-relative projection * view rotation
    vec4 camOffset;         // camera position in RT terrain-rebase coordinates
    vec4 lightDir;          // direction from the surface toward the sun/moon
    vec4 environment;       // xyz celestial radiance
} pc;

vec3 reconstructRasterPosition(ivec2 pix, float depth, ivec2 size) {
    vec2 uv = (vec2(pix) + 0.5) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;
    vec4 h = pc.invViewProj * vec4(ndc, depth, 1.0);
    return pc.camOffset.xyz + h.xyz / max(abs(h.w), 1.0e-8) * sign(h.w);
}

vec3 rasterNormal(ivec2 pix, float depth, ivec2 size, vec3 p) {
    ivec2 px = ivec2(min(pix.x + 1, size.x - 1), pix.y);
    ivec2 py = ivec2(pix.x, min(pix.y + 1, size.y - 1));
    float dx = texelFetch(rasterDepth, px, 0).r;
    float dy = texelFetch(rasterDepth, py, 0).r;
    if (dx <= 1.0e-7 || dy <= 1.0e-7) return vec3(0.0, 1.0, 0.0);
    vec3 n = normalize(cross(reconstructRasterPosition(px, dx, size) - p,
                             reconstructRasterPosition(py, dy, size) - p));
    return n.y < 0.0 ? -n : n;
}

float distantShadow(vec3 p, vec3 normal, ivec2 size) {
    if (dot(pc.lightDir.xyz, pc.lightDir.xyz) < 0.25) return 0.0;
    vec3 dir = normalize(pc.lightDir.xyz);
    vec3 origin = p + normal * 1.5 + dir * 0.5;
    rayQueryEXT query;
    rayQueryInitializeEXT(query, worldTlas,
            gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT
                    | gl_RayFlagsCullBackFacingTrianglesEXT,
            0xFF, origin, 6.0, dir, 10000.0);
    while (rayQueryProceedEXT(query)) { }
    return rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT
            ? 1.0 : 0.0;
}

float ambientVisibility(vec3 p, vec3 normal) {
    rayQueryEXT query;
    rayQueryInitializeEXT(query, worldTlas,
            gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT
                    | gl_RayFlagsCullBackFacingTrianglesEXT,
            0xFF, p + normal * 2.0, 4.0, normal, 72.0);
    while (rayQueryProceedEXT(query)) { }
    return rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT
            ? 1.0 : 0.0;
}

vec3 reflectedSky(vec3 dir) {
    float up = clamp(dir.y * 0.5 + 0.5, 0.0, 1.0);
    float daylight = smoothstep(-0.12, 0.18, pc.lightDir.y);
    vec3 nightHorizon = vec3(0.012, 0.018, 0.040);
    vec3 nightZenith = vec3(0.004, 0.008, 0.028);
    vec3 dayHorizon = vec3(0.48, 0.62, 0.82);
    vec3 dayZenith = vec3(0.12, 0.32, 0.72);
    vec3 sky = mix(mix(nightHorizon, dayHorizon, daylight),
                   mix(nightZenith, dayZenith, daylight), pow(up, 0.65));
    float sun = pow(max(dot(dir, normalize(pc.lightDir.xyz)), 0.0), 900.0);
    return sky + pc.environment.xyz * sun * 0.12;
}

// Screen-space reflection against DH's own depth. The proxy supplies off-screen shadow occlusion, while
// this preserves the real raster LOD colours for water reflections instead of exposing coarse proxy tiles.
vec3 waterReflection(vec3 p, vec3 n, ivec2 size, vec3 fallback) {
    vec3 viewDir = normalize(pc.camOffset.xyz - p);
    vec3 rayDir = normalize(reflect(-viewDir, n));
    mat4 viewProj = inverse(pc.invViewProj);
    float previousDelta = -1.0e20;
    float t = 4.0;
    for (int i = 0; i < 20; i++) {
        vec3 q = p + rayDir * t;
        vec4 clip = viewProj * vec4(q - pc.camOffset.xyz, 1.0);
        if (clip.w <= 0.0) break;
        vec2 uv = clip.xy / clip.w * 0.5 + 0.5;
        if (any(lessThan(uv, vec2(0.002))) || any(greaterThan(uv, vec2(0.998)))) break;
        ivec2 spix = clamp(ivec2(uv * vec2(size)), ivec2(0), size - ivec2(1));
        float sd = texelFetch(rasterDepth, spix, 0).r;
        if (sd > 1.0e-7) {
            vec3 scene = reconstructRasterPosition(spix, sd, size);
            float delta = length(q - pc.camOffset.xyz) - length(scene - pc.camOffset.xyz);
            float thickness = max(2.0, t * 0.018);
            if (abs(delta) <= thickness || (previousDelta < 0.0 && delta > 0.0)) {
                vec3 hitColor = imageLoad(rasterBackground, spix).rgb;
                bool hitIsWater = hitColor.b > hitColor.r * 1.18 && hitColor.g > hitColor.r * 1.05;
                if (!hitIsWater) return hitColor;
            }
            previousDelta = delta;
        }
        t *= 1.32;
    }
    return fallback;
}

// Tonemap seam: map HDR RT radiance to displayable LDR before copying back to the main target.
// The path tracer emits true HDR radiance, so exposure is applied from the compositor-owned 1x1 image
// before the AgX view transform. DLSS-RR still consumes HDR pre-tonemap.

const mat3 AGX_INSET = mat3(
    0.842479062253094, 0.042328242261012, 0.042375654905705,
    0.078433599999999, 0.878468636469772, 0.078433600000000,
    0.079223745147764, 0.079166127460543, 0.879142973793104
);

const mat3 AGX_OUTSET = mat3(
    1.196879005120170, -0.052896851757456, -0.052971635514443,
    -0.098020881140137, 1.151903129904170, -0.098043450117124,
    -0.099029744079720, -0.098961176844843, 1.151073672641160
);

const float AGX_MIN_EV = -12.47393;
const float AGX_MAX_EV = 4.026069;

vec3 agxDefaultContrast(vec3 x) {
    vec3 x2 = x * x;
    vec3 x4 = x2 * x2;
    return 15.5 * x4 * x2
        - 40.14 * x4 * x
        + 31.96 * x4
        - 6.868 * x2 * x
        + 0.4298 * x2
        + 0.1191 * x
        - 0.00232;
}

vec3 applyLook(vec3 color) {
    const float contrast = 1.04;   // try 1.15, 1.25, 1.4
    const float saturation = 1.05; // try 1.05-1.15 if AgX feels grey

    color = clamp((color - 0.5) * contrast + 0.5, 0.0, 1.0);

    float luma = dot(color, vec3(0.2126, 0.7152, 0.0722));
    color = mix(vec3(luma), color, saturation);

    return color;
}

vec3 agx(vec3 color) {
    color = AGX_INSET * max(color, vec3(0.0));
    color = clamp(log2(max(color, vec3(1.0e-10))), AGX_MIN_EV, AGX_MAX_EV);
    color = (color - AGX_MIN_EV) / (AGX_MAX_EV - AGX_MIN_EV);
    color = agxDefaultContrast(color);
    // color = applyLook(color);
    color = AGX_OUTSET * color;
    return clamp(color, 0.0, 1.0);
}

vec3 tonemap(vec3 hdr, float exposure) {
    return agx(hdr * exposure);
}

const float PQ_M1 = 0.1593017578125;
const float PQ_M2 = 78.84375;
const float PQ_C1 = 0.8359375;
const float PQ_C2 = 18.8515625;
const float PQ_C3 = 18.6875;

float pqEncode(float nits) {
    float y = pow(max(nits, 0.0) / 10000.0, PQ_M1);
    return pow((PQ_C1 + PQ_C2 * y) / (1.0 + PQ_C3 * y), PQ_M2);
}

// VK_COLOR_SPACE_HDR10_ST2084_EXT mandates BT.2020 primaries as its container gamut (not just the ST.2084
// transfer function) — but every color we compute (textures, tonemap) is authored/blended in BT.709/sRGB
// primaries. Feeding BT.709 numbers straight into a BT.2020-tagged buffer makes the display read them as
// (more saturated) BT.2020 coordinates, oversaturating everything. This matrix converts linear-light
// BT.709 -> BT.2020 right before the PQ encode, which is the container's actual gamut. (ITU-R BT.2087.)
const mat3 BT709_TO_BT2020 = mat3(
    0.6274039, 0.0690973, 0.0163916,
    0.3292830, 0.9195406, 0.0880132,
    0.0433131, 0.0113612, 0.8955953
);

// HDR display mapping: map exposed scene-linear radiance to absolute nits, then PQ-encode (ST.2084) for
// direct presentation to a PQ/HDR10 swapchain. SDR-range values (<= 1.0 after exposure) stay identity so
// paper white lands exactly at paperWhiteNits. Highlights above 1.0 roll off smoothly and asymptote to
// `headroom`, i.e. the brightest pixels approach peakNits. No SDR clamp here — that is the point.
vec3 tonemapHdr(vec3 hdr, float exposure) {
    vec3 c = max(hdr * exposure, vec3(0.0));
    vec3 lo = min(c, vec3(1.0));
    vec3 hi = max(c - vec3(1.0), vec3(0.0));
    float k = max(pc.headroom - 1.0, 0.0);
    vec3 rolled = (k > 0.0) ? (k * hi) / (k + hi) : vec3(0.0); // -> k as hi -> inf
    vec3 paperReferred = lo + rolled;                          // 1.0 == paper white, max -> headroom
    vec3 nits709 = paperReferred * pc.paperWhiteNits;
    vec3 nits2020 = BT709_TO_BT2020 * nits709;
    return vec3(pqEncode(nits2020.r), pqEncode(nits2020.g), pqEncode(nits2020.b));
}

vec3 displayLinearToHdr(vec3 color) {
    vec3 nits2020 = BT709_TO_BT2020 * (clamp(color, 0.0, 1.0) * pc.paperWhiteNits);
    return vec3(pqEncode(nits2020.r), pqEncode(nits2020.g), pqEncode(nits2020.b));
}

void main() {
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (pix.x >= size.x || pix.y >= size.y) {
        return;
    }

    ivec2 depthSize = imageSize(rtDepth);
    ivec2 depthPix = clamp(ivec2((vec2(pix) + 0.5) * vec2(depthSize) / vec2(size)),
            ivec2(0), depthSize - ivec2(1));
    bool useRasterBackground = pc.dhHybridEnabled != 0 && imageLoad(rtDepth, depthPix).r <= 0.0;
    vec4 raster = imageLoad(rasterBackground, pix);
    bool rasterIsSceneLinear = false;
    float exposure = max(imageLoad(exposureImage, ivec2(0)).r, 0.0);
    float dhDepth = texelFetch(rasterDepth, pix, 0).r;
    if (pc.dhHybridEnabled >= 2 && useRasterBackground && dhDepth > 1.0e-7) {
        vec3 p = reconstructRasterPosition(pix, dhDepth, size);
        vec3 n = rasterNormal(pix, dhDepth, size, p);

        // Preserve DH's texture-pack-derived colour exactly. It is already the final display-referred
        // output; applying RT exposure/gamma here shifts hues and blows out pale resource-pack textures.
        vec3 texturePackColor = raster.rgb;

        float shadow = distantShadow(p, n, size);
        vec3 albedoLinear = pow(max(texturePackColor, vec3(0.0)), vec3(2.2));
        vec3 sunDir = normalize(pc.lightDir.xyz);
        float daylight = smoothstep(-0.10, 0.18, sunDir.y);
        float ndotl = max(dot(n, sunDir), 0.0);
        float ao = ambientVisibility(p, n);
        float skyVisibility = (0.16 + 0.28 * clamp(n.y * 0.5 + 0.5, 0.0, 1.0))
                * mix(0.38, 1.0, ao);
        float direct = daylight * ndotl * (1.0 - shadow) * 1.35;
        float nightFill = mix(0.055, 0.0, daylight);
        vec3 skyTint = mix(vec3(0.52, 0.62, 0.82), vec3(1.0, 0.97, 0.90), daylight);
        vec3 litLinear = albedoLinear * (skyTint * skyVisibility + vec3(direct + nightFill));

        // DH does not expose a material buffer. Flat, blue-dominant surfaces are its water LODs; snow and
        // pale rock are rejected by the blue-vs-red chroma test. Reflect real on-screen DH geometry first.
        bool water = n.y > 0.985 && texturePackColor.b > 0.35 && texturePackColor.g > 0.22
                && texturePackColor.b - texturePackColor.r > 0.12
                && texturePackColor.g > texturePackColor.r * 1.05;
        if (water) {
            vec3 v = normalize(pc.camOffset.xyz - p);
            vec3 reflDir = reflect(-v, n);
            vec3 reflection = waterReflection(p + n * 0.5, n, size, reflectedSky(reflDir));
            vec3 reflectionLinear = pow(max(reflection, vec3(0.0)), vec3(2.2));
            float fresnel = 0.025 + 0.975 * pow(1.0 - clamp(dot(n, v), 0.0, 1.0), 5.0);
            float reflectionWeight = mix(0.22, 0.55, clamp(fresnel, 0.0, 1.0));
            litLinear = mix(litLinear * vec3(0.72, 0.86, 0.94), reflectionLinear, reflectionWeight);
        }
        // From here this follows the same exposure and AgX display transform as native path-traced pixels.
        raster.rgb = max(litLinear, vec3(0.0));
        rasterIsSceneLinear = true;
    }
    vec4 rt = imageLoad(rtImage, pix);
    vec3 ldr = useRasterBackground
            ? (rasterIsSceneLinear ? tonemap(raster.rgb, exposure) : raster.rgb)
            : tonemap(rt.rgb, exposure);
    imageStore(outputImage, pix, vec4(ldr, 1.0));

    if (pc.hdrEnabled != 0) {
        vec3 hdr = useRasterBackground
                ? (rasterIsSceneLinear ? tonemapHdr(raster.rgb, exposure) : displayLinearToHdr(raster.rgb))
                : tonemapHdr(rt.rgb, exposure);
        imageStore(hdrImage, pix, vec4(hdr, 1.0));
    }
}
